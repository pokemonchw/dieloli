msgid ""
"{Name}坐在课桌后方\n"
"躯干向内侧收缩\n"
"腹部传出肠胃蠕动的声响\n"
"双臂交叉按在腹部上方\n"
"头部偏转避开{TargetName}的视线"
msgstr ""

#: Event:d66f5cc7-c5af-4c2f-9e36-33f2b853d795
msgid ""
"{Name}走到{TargetName}身前\n"
"视线自上而下停留在{TargetName}的头顶\n"
"「呼吸不到上面的空气吗」\n"
"{Name}抬起手臂\n"
"手掌在{TargetName}头顶上方平移挥动"
msgstr ""

#: Event:ad686c22-9044-4bd3-b009-32b91ba8d747
msgid ""
"{TargetName}用手臂托住{Name}的背部\n"
"{TargetName}的手掌顺着{Name}的头发向下移动\n"
"「去睡一会吧」\n"
"{TargetName}的身体向{Name}倾斜\n"
"{Name}将头部靠在{TargetName}的肩膀表面"
msgstr ""

#: Event:d469adc8-9ef3-4a0d-b580-81733910733f
msgid ""
"{Name}站在满月的光亮下看着喷泉\n"
"视线越过水流死死盯住{TargetName}的脖颈\n"
"{Name}伸手扯住{TargetName}的衣袖\n"
"压低声音盘问着对方今天的去向\n"
"指尖的力道将布料攥出褶皱"
msgstr ""

#: Event:657ca14f-0bcb-46ee-8cf2-96c8306373ba
msgid ""
"{Name}的腹部发出声响\n"
"{Name}低下头\n"
"{Name}闭上眼睛\n"
"{TargetName}伸出手掌触碰{Name}的手臂\n"
"{TargetName}的嘴角向上拉伸"
msgstr ""

#: Event:9eb8c0b7-3914-469b-8bc6-dfc09c3ff741
msgid ""
"{Name}挺直躯干\n"
"衣服布料在胸前向外隆起\n"
"{Name}的视线向下移动停留在{TargetName}的胸前\n"
"{Name}的手指划过自己的领口边缘\n"
"{Name}的下巴向上抬起"
msgstr ""

#: Event:45c9bb59-dea9-40a5-99c3-8bd25e46c724
msgid ""
"{Name}的手指收紧捏住衣角\n"
"{Name}的视线停留在{TargetName}的鞋尖上\n"
"「那个」\n"
"{Name}的脚步向后方移动拉开距离\n"
"{Name}的下唇向内侧收缩"
msgstr ""

#: Event:b03d895c-1e66-4f04-8dc3-78a188241816
msgid ""
"{Name}背靠着树干站立\n"
"手指从树皮表面划过\n"
"「枯叶坠落的轨迹组成了十四行诗」\n"
"{Name}念出几段特定的发音\n"
"视线停留在下方的泥土上"
msgstr ""

#: Event:dbfdf1cd-e045-447d-9e32-7718a7ac0017
msgid ""
"{Name}指出刚才对话中的常识错误\n"
"{TargetName}发声的动作停止\n"
"{TargetName}的视线移向侧面的地板\n"
"{TargetName}的手指收紧捏住衣角\n"
"{Name}维持原本的站立姿势"
msgstr ""

#: Event:1477ab09-3887-4139-a675-750effde0b87
msgid ""
"{Name}坐在餐椅上\n"
"背部挺直与椅背分离\n"
"「根据这里的环境卫生标准」\n"
"{Name}连续指出三处问题\n"
"语速保持平稳"
msgstr ""

#: Event:87515da9-4ead-4a2e-b0bc-47e74ed68bc1
msgid ""
"{Name}在课桌旁踮起脚跟比划与{TargetName}的头顶高度\n"
"{Name}的乳房随着身体起伏贴上{TargetName}的手臂\n"
"{Name}仰起头直视{TargetName}的眼睛\n"
"{Name}跳步向前拉近两人的距离"
msgstr ""

#: Event:1c10007e-53ac-43a9-ba93-4db0be59f007
msgid ""
"{Name}从画板夹层抽出几张素描草稿\n"
"{Name}用笔尖指着树干纹理的阴影排线\n"
"{Name}向{TargetName}说明光影的透视逻辑\n"
"{Name}的视线在图纸和树林之间来回移动"
msgstr ""

#: Event:3fff15a3-6455-43af-886e-d18aa55dc6b5
msgid ""
"{Name}坐在课桌上\n"
"双手举起翻开的书本\n"
"「这个故事的结局在开头就写好了」\n"
"{Name}指向纸页上的第一段文字\n"
"视线在{TargetName}和书页之间来回移动"
msgstr ""

#: Event:46be00f9-43ab-45a8-a27c-bf408ec850cc
msgid ""
"{Name}听到回应后慢慢闭上双眼\n"
"肩膀微微下沉靠着课桌边缘\n"
"{Name}将额头抵向{TargetName}的手臂\n"
"呼吸逐渐变得平缓"
msgstr ""

#: Event:21ac5b56-d422-42ae-a115-b77e74d221d9
msgid ""
"{Name}伸手捏住{TargetName}的下颌左右端详\n"
"目光顺着眉骨滑移至颧骨\n"
"{Name}抬起另一只手在半空中比划着面部比例\n"
"随后张嘴剖析起眼前的骨相结构"
msgstr ""

#: Event:9d87e92d-3906-40ae-8677-7be4a8ce5e59
msgid ""
"{Name}靠着天台的栏杆滑落坐在地上\n"
"双腿蜷缩收拢紧贴着胸口\n"
"{Name}抬起眼皮看向{TargetName}\n"
"张开嘴唇发出几道喘息声"
msgstr ""

#: Event:62533909-af8b-4eb2-951d-a23c06486a54
msgid ""
"{Name}靠着椅背慵懒地打量着{TargetName}的身体\n"
"毫不掩饰目光中黏腻的欲望\n"
"随口便聊起男女交媾的细节\n"
"用直白的词汇描述着肉棒插入小穴的黏腻水声\n"
"肆意欣赏着对方涨红脸的难堪模样"
msgstr ""

#: Event:de8dc884-a900-4be9-9673-b7d282b5e18b
msgid ""
"{Name}紧紧攥着衣角低着头\n"
"红着脸小声向{TargetName}搭话\n"
"视线局促地停留在对方的鞋尖上\n"
"发出的声音带着微微的颤抖\n"
"断断续续地说着毫无关联的话题"
msgstr ""

#: Event:816f2489-ab85-474e-aa28-c706f8b8d07e
msgid ""
"{TargetName}双臂交叉在胸前\n"
"背部微微弓起\n"
"视线避开{Name}\n"
"看向地面\n"
"鞋底在地上摩擦"
msgstr ""

#: Event:365b0c60-a1cd-47d3-ab4f-b2d52a1efb09
msgid ""
"{Name}端着餐盘走到{TargetName}对面坐下\n"
"将自己的餐盘推向桌子中央\n"
"身体后仰靠在椅背上\n"
"下巴微微抬起\n"
"视线自上而下扫过对方的餐盘"
msgstr ""

#: Event:c5998a0c-3b0e-4ca2-90a3-725b6fdd5bec
msgid ""
"{Name}的后背靠在墙面上\n"
"双臂交叉环抱在胸前\n"
"呼吸的频率加快\n"
"「不需要休息」\n"
"{Name}抬起下巴注视着{TargetName}的面部"
msgstr ""

#: Event:da1e0fe0-0c09-4c12-9de6-c12c886405b1
msgid ""
"{Name}停留在树干后方\n"
"手指捏住树皮表面的缝隙\n"
"视线向下停留在{TargetName}的鞋面上\n"
"「留下来」\n"
"双唇张开的间距不足一厘米"
msgstr ""

#: Event:8e001226-3c6e-48bf-892f-7260297d2f3b
msgid ""
"{Name}的躯干阻挡在{TargetName}的移动路线上\n"
"{Name}死死盯着{TargetName}的瞳孔\n"
"「刚才为什么和其他人说话」\n"
"{Name}的手指收紧扣住{TargetName}的手腕\n"
"指关节表面的皮肤泛白"
msgstr ""

#: Event:afa23eff-505b-4971-bf5a-5a595bd1fdd6
msgid ""
"{Name}拿着一本书走到{TargetName}的课桌旁\n"
"翻开做有标记的书页指着上面的文字\n"
"「这里的文本打破了叙事结构」\n"
"{Name}的手指顺着段落移动\n"
"目光停留在{TargetName}的脸上"
msgstr ""

#: Event:62a3f71c-7cc3-4886-9a2d-b0a51c911002
msgid ""
"{Name}靠着天台的栏杆指向夜空里明亮的圆月\n"
"「据说月球上其实是奶酪做的」\n"
"{Name}收回手在半空中比划了一个咀嚼的动作\n"
"看着{TargetName}笑了一下\n"
"「真想切一块尝尝味道」"
msgstr ""

#: Event:5b5d60c4-9bcf-4095-a3b8-c3b1db41ef1c
msgid ""
"{Name}停在{TargetName}的课桌旁\n"
"手掌向下按压木质桌面\n"
"「走廊的窗玻璃掉在地板上了」\n"
"{Name}的上下颚交替张合\n"
"声音没有停顿地构成多个长句"
msgstr ""

#: Event:1e2002c3-2b75-49b9-9ca6-01e5a3312e12
msgid ""
"{Name}坐在天台的护栏边缘\n"
"手指对着夜空中的满月比划出一个圆\n"
"「月亮表面那个黑色的斑块是一只大象」\n"
"{Name}转头看向{TargetName}\n"
"双腿在半空中前后晃动"
msgstr ""

#: Event:388723b3-ce43-4f2d-8be7-52557e312ce3
msgid ""
"{Name}赤身裸体坐在教室的课桌上\n"
"双腿向两侧分开\n"
"{Name}看着{TargetName}\n"
"「你的肉棒平时也会像这样硬起来吗」\n"
"手指顺着大腿内侧滑向小穴"
msgstr ""

#: Event:bdba284d-4951-43cd-8fd1-8719c07d962d
msgid ""
"{Name}拉开餐椅坐在{TargetName}的对面\n"
"双手交叉垫在下颌下方\n"
"「你刚才转头看入口处看了三秒钟」\n"
"{Name}的上半身向前倾斜越过桌面边缘\n"
"视线固定在{TargetName}的瞳孔上"
msgstr ""

#: Event:42b052b0-4784-4c45-99bf-8582665cd848
msgid ""
"{Name}坐在喷泉池的边缘\n"
"双腿在水面上方前后晃动\n"
"视线停留在{TargetName}的胸口处\n"
"手指在水面上拨弄出水花\n"
"「这里的水面完全没有任何起伏呢」"
msgstr ""

#: Event:24682ec7-bab2-4d59-83e1-2d6c0a41e8dc
msgid ""
"{Name}坐在课桌上\n"
"低头看着面前的{TargetName}\n"
"「你就只能做到这种程度了吧」\n"
"{Name}嘴角向上牵扯\n"
"视线越过{TargetName}看向黑板"
msgstr ""

#: Event:80544963-c0de-4202-8853-038f00e2eb75
msgid ""
"{TargetName}站到{Name}身旁\n"
"抬手贴住自己的头顶\n"
"手掌停在{Name}的肩侧\n"
"「差一点」\n"
"{TargetName}踮起脚跟"
msgstr ""

#: Event:6f772164-3d40-4055-841a-9a3ed2fee446
msgid ""
"{Name}站在喷泉旁\n"
"看着{TargetName}\n"
"「不对」\n"
"{Name}抬手比出一段距离\n"
"话说到一半又停住"
msgstr ""

#: Event:8ceadf4e-1837-4f8d-b377-baf1db41037e
msgid ""
"{TargetName}把餐盘向旁边挪开\n"
"手掌停在桌面边缘\n"
"{Name}的话说到一半停住\n"
"{TargetName}点了点头\n"
"{Name}重新看向{TargetName}"
msgstr ""

#: ClothingName:621d296a-9c1d-49c4-afd1-034359005878
msgid "深衣"
msgstr ""

#: ClothingDescribe:621d296a-9c1d-49c4-afd1-034359005878
msgid ""
"汉服的一种，就是上衣和下裳相连在一起，用不同色彩的布料作为边缘，其特点是使是"
"使身体深藏不露，雍容典雅．"
msgstr ""

#: ClothingName:39426587-13c1-4e55-b5be-1a2527cde30f
msgid "直缀"
msgstr ""

#: ClothingDescribe:39426587-13c1-4e55-b5be-1a2527cde30f
msgid "又作直裰．系僧侣之法衣一种，即将偏衫与裙子合缀而成之僧服．"
msgstr ""

#: ClothingName:1fc481f0-674c-4512-baee-ce7317c385e1
msgid "短打"
msgstr ""

#: ClothingDescribe:1fc481f0-674c-4512-baee-ce7317c385e1
msgid ""
"短打是古代汉服的一种，又称竖褐、裋褐．以劳作方便为目的的便服，与常服和礼服相"
"区别．"
msgstr ""

#: ClothingName:4187b3ad-2e9d-4fd0-9374-69230f0e881b
msgid "绗缝夹克"
msgstr ""

#: ClothingDescribe:4187b3ad-2e9d-4fd0-9374-69230f0e881b
msgid ""
"深蓝色短款、小立领夹克简洁又时髦，薄棉通过绗缝的设计丝毫不显厚重，搭配格子长"
"裤，打造出英伦风范的味道．"
msgstr ""

#: ClothingName:decdf116-b352-4ea0-b861-21a3c68e9fe6
msgid "休闲夹克"
msgstr ""

#: ClothingDescribe:decdf116-b352-4ea0-b861-21a3c68e9fe6
msgid "尼龙质地的简约风格夹克，休闲旅行的常用搭配．"
msgstr ""

#: ClothingName:38fab5ce-3a7e-4707-b0b5-0680926da4ee
msgid "翻领夹克"
msgstr ""

#: ClothingDescribe:38fab5ce-3a7e-4707-b0b5-0680926da4ee
msgid ""
"大翻领配合拉链的夹克同样具有军装风貌，也可以叫哈雷机车夹克或摇滚夹克。领口是"
"重点设计环节，暗扣或拉链装置随时可以加上保暖的毛领，还能根据需求竖起领子，或"
"者配条围巾，防风又保暖．"
msgstr ""

#: ClothingName:c8f91d8e-5a89-433e-bc40-6f5cba5990e2
msgid "猎装夹克"
msgstr ""

#: ClothingDescribe:c8f91d8e-5a89-433e-bc40-6f5cba5990e2
msgid ""
"比起常见的皮质和水洗布猎装夹克，尼龙面料更显斯文。下摆的两个贴袋设计别致，兼"
"具装饰与实用性．"
msgstr ""

#: ClothingName:b7289307-7290-401d-84a9-0b3a1884bd3d
msgid "羽绒夹克"
msgstr ""

#: ClothingDescribe:b7289307-7290-401d-84a9-0b3a1884bd3d
msgid ""
"羽绒夹克一般拥有开襟、修身设计，并以保暖清透的棉纶、羽绒等作为内胆或填充物，"
"利用涤纶、锦纶等舒适防风材质，让这款服饰将温暖、合身的优点结合．"
msgstr ""

#: ClothingName:bc96ee05-9abe-4d67-84b1-f6b2ab63387a
msgid "旗袍"
msgstr ""

#: ClothingDescribe:bc96ee05-9abe-4d67-84b1-f6b2ab63387a
msgid "源于汉服中的深衣，成型于20世纪20年代，在世界范围内受到一定欢迎．"
msgstr ""

#: ClothingName:a148a8ea-91cc-405d-98c3-2b5ac71e0755
msgid "襦裙"
msgstr ""

#: ClothingDescribe:a148a8ea-91cc-405d-98c3-2b5ac71e0755
msgid ""
"襦裙是汉服的一种，上身穿的短衣和下身束的裙子合称襦裙，是典型的“上衣下裳”衣"
"制．上衣叫做“襦”，长度较短，一般长不过膝，下身则叫“裙”．"
msgstr ""

#: ClothingName:7d46db1a-0ea9-450f-96c5-467a9fee15cd
msgid "罩衫"
msgstr ""

#: ClothingDescribe:7d46db1a-0ea9-450f-96c5-467a9fee15cd
msgid ""
"罩衫是一种宽松的上衣，通常为女性和儿童穿着。罩衫可以为长袖、短袖或无袖，并在"
"领口或袖口两处或任意一处收紧。圆领和一字领的设计皆很常见。"
msgstr ""

#: ClothingName:861c4a80-392c-4414-a978-22f26df87c1f
msgid "直身裙"
msgstr ""

#: ClothingDescribe:861c4a80-392c-4414-a978-22f26df87c1f
msgid ""
"直身裙特点是胸围、腰围和裙围，三者基本上一样粗细，形成一种直筒式的形状．衣片"
"结构，是上下相连，腰间不作剪断．有时为了跨步方便，在近裙摆处接上一段收有折裥"
"的接边．"
msgstr ""

#: ClothingName:82dad58f-a708-45ad-9f82-1f63b1918466
msgid "A字连衣裙"
msgstr ""

#: ClothingDescribe:82dad58f-a708-45ad-9f82-1f63b1918466
msgid ""
"侧缝由胸围处向下展开至裙底摆，外形似A字，由于A型的外轮廓从直线变成斜线而增加"
"了长度，进而达到了高度上的夸张，是女装常用的外型，具有活泼、潇洒、充满青春活"
"力的造型风格．"
msgstr ""

#: ClothingName:dde3d22c-cbc0-4674-aa25-35c7e4a2b863
msgid "露背裙"
msgstr ""

#: ClothingDescribe:dde3d22c-cbc0-4674-aa25-35c7e4a2b863
msgid ""
"露背裙后背裸露至腰，是连衣裙中比较性感的一种款式之一，在面料的选择上，当然宜"
"选用柔且悬垂效果好的面料裁制，因为这种面料的柔软性会对人体的肌肤会比较有利，"
"不会因为面料过于粗硬而对身体造成伤害．"
msgstr ""

#: ClothingName:ed324438-9242-4e22-9cd3-d46266efa098
msgid "吊带连衣裙"
msgstr ""

#: ClothingDescribe:ed324438-9242-4e22-9cd3-d46266efa098
msgid ""
"吊带连衣裙，和背带裙不同，背带一般者较宽长，并在背后打衩，而吊带裙较窄短。吊"
"带裙一般在腰节以上部位都有一段护胸和护背的衣料．在盛夏季节穿着凉快、舒适，除"
"了女童以外，成人也穿着，现代比较流行．"
msgstr ""

#: ClothingName:505162cc-0b83-4a84-bc97-3b0a1b606626
msgid "牛仔连衣裙"
msgstr ""

#: ClothingDescribe:505162cc-0b83-4a84-bc97-3b0a1b606626
msgid ""
"牛仔连衣裙，是指由牛仔布料为主设计的连衣裙子，牛仔裙以其布料耐穿，耐洗为特"
"色，"
msgstr ""

#: ClothingName:b0a0380e-e607-4875-9d60-51ff0fa430c0
msgid "蕾丝连衣裙"
msgstr ""

#: ClothingDescribe:b0a0380e-e607-4875-9d60-51ff0fa430c0
msgid "是一种由蕾丝制成的质感轻薄、柔软、飘逸的连衣裙．"
msgstr ""

#: ClothingName:48545f6c-6a3b-4318-a001-e08ccd6af0c2
msgid "雪纺连衣裙"
msgstr ""

#: ClothingDescribe:48545f6c-6a3b-4318-a001-e08ccd6af0c2
msgid ""
"雪纺连衣裙是一种由雪纺制成的质感轻薄、透明、柔软、飘逸的连衣裙。穿着舒适、轻"
"盈，在炎热的盛夏有一种清凉的感觉．"
msgstr ""

#: ClothingName:337cfac9-24ec-4c82-befe-93f9597ae91f
msgid "紧腰宽裙"
msgstr ""

#: ClothingDescribe:337cfac9-24ec-4c82-befe-93f9597ae91f
msgid "阿尔卑斯村姑式连衣裙(有紧胸褡和束腰宽摆裙)．"
msgstr ""

#: ClothingName:5c5ed7ec-95eb-4600-a516-883de40bdbbd
msgid "小纹和服"
msgstr ""

#: ClothingDescribe:5c5ed7ec-95eb-4600-a516-883de40bdbbd
msgid "无论图案的大小，反复印染的纹样的和服．"
msgstr ""

#: ClothingName:f26a1588-e865-47e2-8b96-b6e2e9d49d7b
msgid "色无地"
msgstr ""

#: ClothingDescribe:f26a1588-e865-47e2-8b96-b6e2e9d49d7b
msgid "整件衣服仅有除了黑色以外单一色彩而没有图案的一类和服．"
msgstr ""

#: ClothingName:6d5fcf8c-90a4-4532-9aba-599ff84b489d
msgid "付下和服"
msgstr ""

#: ClothingDescribe:6d5fcf8c-90a4-4532-9aba-599ff84b489d
msgid ""
"付下和服可以看成是访问着的简化版．是对袖子，前后身，领子的图案全是自下而上的"
"方向印染的和服的总称．"
msgstr ""

#: ClothingName:04258b0d-0812-41de-a96e-fde6355d6888
msgid "访问和服"
msgstr ""

#: ClothingDescribe:04258b0d-0812-41de-a96e-fde6355d6888
msgid ""
"访问和服是明治时代因应洋服的Visiting Dress而产生的类别．它从下摆，左前袖，左"
"肩到领子展开后是一幅图画，特徵是称为「絵羽（えば）」的这种形式．指的是在访问"
"着上的图案，跨越缝线，可拼成一整幅大图案．"
msgstr ""

#: ClothingName:fde44299-0a84-4c77-9c4e-51c6bb45d5ae
msgid "振袖和服"
msgstr ""

#: ClothingDescribe:fde44299-0a84-4c77-9c4e-51c6bb45d5ae
msgid ""
"振袖为未婚女性所穿着的和服，有色彩斑斓的图案及纹理．它依照袖的长短分为大振"
"袖、中振袖及小振袖，而袖长大约于39吋至42吋之间．振袖为现今未婚女性最正式的服"
"饰，是未婚女性参与成人节或者亲友婚礼的常见服饰．"
msgstr ""

#: ClothingName:521664bd-1c65-4772-875b-dfa390271123
msgid "留袖和服"
msgstr ""

#: ClothingDescribe:521664bd-1c65-4772-875b-dfa390271123
msgid ""
"留袖分为黑留袖和色留袖，黑留袖就是黑色的留袖，黑留袖为已婚女性最正式的着装，"
"在两胸前、两袖、背后有5个家纹．而只有三个家纹的为次正式的．未婚女性不能穿黑留"
"袖．色留袖就是彩色的留袖，色留袖为较平常的服装，未婚女性也可以穿着．"
msgstr ""

#: ClothingName:6473f8d9-9e05-4e18-8ece-2fc67634f707
msgid "袴"
msgstr ""

#: ClothingDescribe:6473f8d9-9e05-4e18-8ece-2fc67634f707
msgid ""
"和服的一种，通常为参与一些毕业典礼时的穿着．与普通和服不同的是，它的鞋可以是"
"马靴．这是明治时代末期至昭和初期的女子校服所演变而成的．"
msgstr ""

#: ClothingName:18363553-3f92-4e85-9ac5-ffeb00e91d29
msgid "羽绒服"
msgstr ""

#: ClothingDescribe:18363553-3f92-4e85-9ac5-ffeb00e91d29
msgid ""
"内充羽绒填料的上衣，外形庞大圆润。羽绒服一般鸭绒量占一半以上，同时可以混杂一"
"些细小的羽毛，将鸭绒清洗干净，经高温消毒，之后填充在衣服中就是羽绒服了．"
msgstr ""

#: ClothingName:ac159b93-4087-416a-b9ab-545518b02a74
msgid "风衣"
msgstr ""

#: ClothingDescribe:ac159b93-4087-416a-b9ab-545518b02a74
msgid "一种防风的轻薄型大衣。风衣是服饰中的一种，适合于春、秋、冬季外出穿着．"
msgstr ""

#: ClothingDescribe:98295c47-038c-446d-a5a8-019060c3ecb8
msgid ""
"一般指由防水布料制成的挡雨衣服。雨衣适用的防水布料有胶布、油布和塑料薄膜等．"
msgstr ""

#: ClothingName:927784ac-4d15-47a1-918d-92b54e2584e3
msgid "和式浴衣"
msgstr ""

#: ClothingDescribe:927784ac-4d15-47a1-918d-92b54e2584e3
msgid "和服的一种，只在洗澡前后穿，一般为长袍型．"
msgstr ""

#: ClothingName:4b09f39c-929c-44b2-99ff-72b286413d26
msgid "白无垢"
msgstr ""

#: ClothingDescribe:4b09f39c-929c-44b2-99ff-72b286413d26
msgid ""
"和服的一种，是表裹完全纯白色的和服．在古代日本，白色是神圣颜色．室町时代末期"
"至江户时代，生产、葬礼、切腹也穿这种和服．明治以后，神道的结婚仪式期间，女方"
"也穿这种和服做为新娘服．"
msgstr ""

#: ClothingName:c0a61628-2cc1-4d15-bf3f-34f5d3516650
msgid "和式丧服"
msgstr ""

#: ClothingDescribe:c0a61628-2cc1-4d15-bf3f-34f5d3516650
msgid ""
"丧服（五纹）便是在丧礼上穿的和服，全黑（除长襦袢外），包括腰带等一些小物都是"
"黑色．带家纹，属于五纹和服．有些丧服没有暗纹，有些带有纱绫形、云、莲、流水、"
"波等暗纹．"
msgstr ""

#: ClothingName:484ea18c-f70d-4993-98dc-9540d3cabd9a
msgid "纱丽"
msgstr ""

#: ClothingDescribe:484ea18c-f70d-4993-98dc-9540d3cabd9a
msgid ""
"是一种用丝绸为主要材料制作而成的衣服，一般长5.5米，宽1.25米，两侧有滚边，上面"
"有刺绣。通常围在长及足踝的衬裙上，从腰部围到脚跟成筒裙状，然后将末端下摆披搭"
"在左肩或右肩．"
msgstr ""

#: ClothingName:dd0c3475-f56f-4959-b032-9f8371233e23
msgid "连体泳装"
msgstr ""

#: ClothingDescribe:dd0c3475-f56f-4959-b032-9f8371233e23
msgid ""
"连体泳装是一种通常给女性及伪娘穿着的泳装，为紧身设计，对皮肤具有良好的遮蔽性"
"（不过目前也有很多连体泳装为低胸和露背设计）．"
msgstr ""

#: ClothingName:7bc39216-480f-4e5b-a252-8a0bad248eff
msgid "筒式泳装"
msgstr ""

#: ClothingDescribe:7bc39216-480f-4e5b-a252-8a0bad248eff
msgid ""
"筒式泳装显得较为别致，它的衣身呈筒状，加上吊带，有的吊带是可拆卸的。这种泳装"
"能降低胸部和臀部的透明度，高裁的底边可以使腿部线条显得长一些．"
msgstr ""

#: ClothingName:2b0a165b-c3d8-4ccb-80e2-0b56a71c2175
msgid "男式衬衫"
msgstr ""

#: ClothingDescribe:2b0a165b-c3d8-4ccb-80e2-0b56a71c2175
msgid "男式的贴身穿着的单衣．"
msgstr ""

#: ClothingName:20dd36d5-f9b7-4114-ac17-7060c98809e5
msgid "女式衬衫"
msgstr ""

#: ClothingDescribe:20dd36d5-f9b7-4114-ac17-7060c98809e5
msgid "女式的贴身穿着的单衣．"
msgstr ""

#: ClothingName:d8da95df-54ee-4474-9bde-cb3bb77bce4c
msgid "T恤"
msgstr ""

#: ClothingDescribe:d8da95df-54ee-4474-9bde-cb3bb77bce4c
msgid ""
"T恤衫又称T形衫。起初是内衣，实际上是翻领半开领衫，后来才发展到外衣，包括T恤汗"
"衫和T恤衬衫两个系列．"
msgstr ""

#: ClothingName:1e495ebc-2eb5-466c-8cba-86dbaf93804e
msgid "背心"
msgstr ""

#: ClothingDescribe:1e495ebc-2eb5-466c-8cba-86dbaf93804e
msgid ""
"无袖上衣，也称为马甲或坎肩，是一种无领无袖，且较短的上衣。主要功能是使前后胸"
"区域保温并便于双手活动．"
msgstr ""

#: ClothingName:00c3be13-1ee8-46e7-bef6-bea56b533249
msgid "锥型裤"
msgstr ""

#: ClothingDescribe:00c3be13-1ee8-46e7-bef6-bea56b533249
msgid "从臀围到裤脚逐渐收缩，形似锥子或胡萝卜状，所以也叫叫萝卜裤．"
msgstr ""

#: ClothingName:e4f27bc1-24ae-4187-b7b7-99cf8e66e1ad
msgid "哈伦裤"
msgstr ""

#: ClothingDescribe:e4f27bc1-24ae-4187-b7b7-99cf8e66e1ad
msgid ""
"来自保守的穆斯林妇女服装，这种裤子的名称来源于伊斯兰词汇哈伦，它起源于伊斯兰"
"后宫女子的穿着，所以又名伊斯兰后宫裤．"
msgstr ""

#: ClothingName:f5558271-1402-4745-8243-3e59850730a6
msgid "裙裤"
msgstr ""

#: ClothingDescribe:f5558271-1402-4745-8243-3e59850730a6
msgid ""
"像裤子一样具有下裆，裤下口放宽，外观形似裙子，是裤子与裙子的一种结合体．"
msgstr ""

#: ClothingName:db8c90d9-6609-48f4-ae95-302b1dea5eab
msgid "喇叭裤"
msgstr ""

#: ClothingDescribe:db8c90d9-6609-48f4-ae95-302b1dea5eab
msgid ""
"因裤腿形状似喇叭而得名．它的特点是：低腰短裆，紧裹臀部；裤腿上窄下宽，从膝盖"
"以下逐渐张开，裤口的尺寸明显大于膝盖的尺寸，形成喇叭状．"
msgstr ""

#: ClothingName:85af9bf6-92c0-4c76-9f5d-5dc30dace7b7
msgid "九分裤"
msgstr ""

#: ClothingDescribe:85af9bf6-92c0-4c76-9f5d-5dc30dace7b7
msgid ""
"九分裤指裤子的长度按照人正常裤子长度的十分之九（9/10）长做出来的，或者裤子穿"
"在身上之后的长度到脚踝位置的．九分裤是长裤的一种，但是它不同于普通长裤，与长"
"裤的差别是它的长度不超过脚踝．"
msgstr ""

#: ClothingName:e8438f5c-5c6a-42bd-8f3f-9a27c611cd54
msgid "三分裤"
msgstr ""

#: ClothingDescribe:e8438f5c-5c6a-42bd-8f3f-9a27c611cd54
msgid "以防走光为主要功能的打底裤．"
msgstr ""

#: ClothingName:a1909614-7aff-436c-b703-61594eddd503
msgid "女式紧身裤"
msgstr ""

#: ClothingDescribe:a1909614-7aff-436c-b703-61594eddd503
msgid ""
"又称内搭裤，是从腰部到脚的紧身长裤．由于它的穿着方式类似裤袜，也有人称内搭"
"袜，类型属于裤袜，是无法包覆脚掌的袜子，穿着时袜口大致介于膝盖至脚踝间，通常"
"为女性、舞蹈人员所穿着，因此又称内搭袜、无底袜．"
msgstr ""

#: ClothingName:3f20e0c5-db4b-4ba8-9f9f-4253460316a8
msgid "背带裤"
msgstr ""

#: ClothingDescribe:3f20e0c5-db4b-4ba8-9f9f-4253460316a8
msgid ""
"腰上装有挎肩背带的裤子．西裤中的背带裤仅为两根挎带相连，而在工装裤及现代时装"
"中多有前胸补块．又称饭单裤或工装裤，是在普通的长裤或短裤上面，加一只护胸(俗称"
"饭单)，穿着时系用背带，不用腰带，故名．"
msgstr ""

#: ClothingName:d2243cff-d2b8-4997-a333-8ca85274aa2e
msgid "阔腿裤"
msgstr ""

#: ClothingDescribe:d2243cff-d2b8-4997-a333-8ca85274aa2e
msgid "从大腿开始到裤脚一直都是较宽的裤子．"
msgstr ""

#: ClothingName:f3e8901d-32ae-4eb1-927c-b77786d061fa
msgid "工装裤"
msgstr ""

#: ClothingDescribe:f3e8901d-32ae-4eb1-927c-b77786d061fa
msgid ""
"设计了腰部上下都能保护人体的连衣工装裤．一个世纪之前，工装裤风靡于世全仗百磨"
"不破的那股憨厚劲，为建设中的美国节约了整码整码的布匹．工装裤本来是男装，但时"
"装化后却更受女孩子的喜爱．"
msgstr ""

#: ClothingName:5f4d8390-ae93-4d14-97fe-b6a7f283130b
msgid "羊绒裤"
msgstr ""

#: ClothingDescribe:5f4d8390-ae93-4d14-97fe-b6a7f283130b
msgid "羊绒裤是以山羊绒为原料针织而成的服装．"
msgstr ""

#: ClothingName:f3536629-d6bf-47df-8c18-324cdcceee4a
msgid "牛仔裤"
msgstr ""

#: ClothingDescribe:f3536629-d6bf-47df-8c18-324cdcceee4a
msgid ""
"通常由斜纹布或斜纹粗棉布做的工作或运动时穿用的裤子，任何质地的瘦腿紧身裤．"
msgstr ""

#: ClothingName:840262cf-b694-4e15-bef8-9e0e08f30982
msgid "西裤"
msgstr ""

#: ClothingDescribe:840262cf-b694-4e15-bef8-9e0e08f30982
msgid "与西装上衣配套穿着的长裤．"
msgstr ""

#: ClothingName:e42bd649-0fdd-49c3-b140-46214718ddff
msgid "七分裤"
msgstr ""

#: ClothingDescribe:e42bd649-0fdd-49c3-b140-46214718ddff
msgid "七分裤是指裤长七分，长及膝下小腿的裤子．"
msgstr ""

#: ClothingName:04c3323c-815e-49cf-83a0-7704467c2b1c
msgid "五分裤"
msgstr ""

#: ClothingDescribe:04c3323c-815e-49cf-83a0-7704467c2b1c
msgid ""
"五分裤指是长裤的一半，所以也可称之为半裤．裤子长度为20英寸，大约在膝盖部位，"
"一般不过膝盖．"
msgstr ""

#: ClothingName:0de07d01-4529-432e-9925-bfff49985967
msgid "直筒裤"
msgstr ""

#: ClothingDescribe:0de07d01-4529-432e-9925-bfff49985967
msgid "指从臀部最高点到裤脚的宽度都是同一尺寸的裤子．"
msgstr ""

#: ClothingName:62c6b7a4-12ba-483e-a946-4587b008b8de
msgid "开裆裤"
msgstr ""

#: ClothingDescribe:62c6b7a4-12ba-483e-a946-4587b008b8de
msgid ""
"这种内裤恰巧在两股之间空无遮掩，如果又穿迷你裙外出，可够令人提心吊胆的，这是"
"叫人目瞪口呆、火辣辣的设计．"
msgstr ""

#: ClothingName:537adf3b-8f5a-4ec1-a4b7-eaedd1ce3c41
msgid "A字裙"
msgstr ""

#: ClothingDescribe:537adf3b-8f5a-4ec1-a4b7-eaedd1ce3c41
msgid "字母A的形状，包裹在腰部，然后下摆展开。非常简单的款式．"
msgstr ""

#: ClothingName:b23d088c-1c27-4ff5-8891-0ea97eaf9f2b
msgid "不对称裙"
msgstr ""

#: ClothingDescribe:b23d088c-1c27-4ff5-8891-0ea97eaf9f2b
msgid ""
"简单的理解就是一边长来一边短~无论前后左右，总之就是不对称~有可能是单层也可以"
"使折叠多层，无所累啦~只要两边的底边不相等，就是一条不对称的裙子．"
msgstr ""

#: ClothingName:9d24544b-bb79-4194-8bc8-e4b01d18352f
msgid "铃铛裙"
msgstr ""

#: ClothingDescribe:9d24544b-bb79-4194-8bc8-e4b01d18352f
msgid "这条裙子的重点就是将你的腰部紧紧包裹，然后展开直至膝盖处才下垂．"
msgstr ""

#: ClothingName:5ad70f7e-3c26-4403-b8ba-4da439fe6b31
msgid "泡泡裙"
msgstr ""

#: ClothingDescribe:5ad70f7e-3c26-4403-b8ba-4da439fe6b31
msgid ""
"虽然很小女生，但是就是真的很小女生，也就是说，如果你发育的很好，大胸大屁股的"
"话，真的不要尝试这款裙子，能够穿它的也就是那些身材娇小的女孩子，或者是干瘦的"
"那种．"
msgstr ""

#: ClothingName:d6d785a2-49c3-4492-9c79-c7462e0884aa
msgid "牛仔裙"
msgstr ""

#: ClothingDescribe:d6d785a2-49c3-4492-9c79-c7462e0884aa
msgid "用牛仔布料制成，是诸多裙装中修饰最少、穿着最随着的服装．"
msgstr ""

#: ClothingName:2d4a3a79-811b-465f-83b3-3d1568b02469
msgid "牛津鞋"
msgstr ""

#: ClothingDescribe:2d4a3a79-811b-465f-83b3-3d1568b02469
msgid ""
"牛津鞋是指从17世纪英国赫赫有名的牛津大学所开始流行的男生制服鞋，牛津鞋在鞋子"
"楦头以及鞋身两侧，往往会做出如雕花般的翼纹设计，通常鞋面打三个以上的孔眼，再"
"以系带绑绳固定．"
msgstr ""

#: ClothingName:657e3b3f-85b2-4f1d-abe4-c51e72cea054
msgid "乐福鞋"
msgstr ""

#: ClothingDescribe:657e3b3f-85b2-4f1d-abe4-c51e72cea054
msgid "多数指的是无鞋带的平底或低帮皮鞋，特点是易穿易脱．"
msgstr ""

#: ClothingName:6ade2276-4145-4b9e-9c0d-0d04e4c1de2a
msgid "坡跟高跟鞋"
msgstr ""

#: ClothingDescribe:6ade2276-4145-4b9e-9c0d-0d04e4c1de2a
msgid ""
"坡跟高跟鞋的设计使得鞋子鞋跟部分与地面的接触面积相较于细跟高跟鞋的要大，能更"
"轻松的站稳，是女生穿高跟鞋的入门款，可以在平底鞋与细跟高跟鞋之间做一个很好的"
"过渡．"
msgstr ""

#: ClothingName:105219db-7d87-4e6e-be81-35802ebc351d
msgid "矮方跟女鞋"
msgstr ""

#: ClothingDescribe:105219db-7d87-4e6e-be81-35802ebc351d
msgid ""
"女鞋款式的一种，就一般高跟鞋的样式，但是鞋跟较短(小于3cm)，粗大而呈方形．"
msgstr ""

#: ClothingName:02d90830-4ff3-4718-a364-c12d054979e5
msgid "锥形跟女鞋"
msgstr ""

#: ClothingDescribe:02d90830-4ff3-4718-a364-c12d054979e5
msgid "有跟女鞋的通常款式，中低高跟都有．"
msgstr ""

#: ClothingName:a3fb699b-6398-4945-8b9c-eda3428998d8
msgid "笼式跟女鞋"
msgstr ""

#: ClothingDescribe:a3fb699b-6398-4945-8b9c-eda3428998d8
msgid "鞋跟比锥形跟要宽，比方形跟要窄，呈鸟笼状，中空，装饰精美．"
msgstr ""

#: ClothingName:a906d5df-ddca-4271-ba47-06127edf6ed4
msgid "逗号跟高跟鞋"
msgstr ""

#: ClothingDescribe:a906d5df-ddca-4271-ba47-06127edf6ed4
msgid "鞋跟为向后弯曲的细高跟，呈逗号状．"
msgstr ""

#: ClothingName:01737f35-e7fb-4065-b9d7-162bb79f4e96
msgid "细高跟女鞋"
msgstr ""

#: ClothingDescribe:01737f35-e7fb-4065-b9d7-162bb79f4e96
msgid "俗称恨天高，是高跟鞋中，鞋跟最高的款式．"
msgstr ""

#: ClothingName:535e2e2b-b9f6-4077-8a40-9d91cd8dba81
msgid "木屐"
msgstr ""

#: ClothingDescribe:535e2e2b-b9f6-4077-8a40-9d91cd8dba81
msgid ""
"简称屐，是一种两齿木底鞋，走起来路来吱吱作响，适合在南方雨天、泥上行走．若鞋"
"面为帛制成，则称为帛屐．牛皮制作则称作牛皮屐．木制底下是四个铁钉，耐磨、防"
"滑．"
msgstr ""

#: ClothingName:73edf963-3fe4-4de6-b6d8-5901dfed63c7
msgid "僧侣鞋"
msgstr ""

#: ClothingDescribe:73edf963-3fe4-4de6-b6d8-5901dfed63c7
msgid ""
"僧侣鞋也被叫做孟克鞋，是商务场所正式度第二高的正装皮鞋．它标志性的特征是横跨"
"脚面、有金属扣环的横向搭带．"
msgstr ""

#: ClothingName:ef0994f4-1d1a-4fa4-9ba2-4581c013cbdb
msgid "德比鞋"
msgstr ""

#: ClothingDescribe:ef0994f4-1d1a-4fa4-9ba2-4581c013cbdb
msgid ""
"德比鞋是在欧洲非常流行的一种绑带鞋的统称，Derbies德比鞋，又名为Lace-ups，是商"
"务场所正式度第三高的正装皮鞋．德比鞋特点是鞋舌与整个鞋面采用一张皮革，两片鞋"
"耳之间用鞋带固定出一些间距，这样便于调节松紧．"
msgstr ""

#: ClothingName:09279fa0-046c-4d7d-839e-bd37ebce1693
msgid "切尔西靴"
msgstr ""

#: ClothingDescribe:09279fa0-046c-4d7d-839e-bd37ebce1693
msgid ""
"切尔西靴源于英国维多利亚时代马术活动的靴子,曾因为风靡全球的传奇乐队Beatles而"
"大红大紫．特点：低跟、圆形鞋头、无鞋带、非高跟、高及脚踝，鞋子前后用不同的皮"
"革原料制成，利用侧面的松紧带收紧靴筒．"
msgstr ""

#: ClothingName:4675cc95-1085-4249-aff8-e41673ca5c70
msgid "沙漠靴"
msgstr ""

#: ClothingDescribe:4675cc95-1085-4249-aff8-e41673ca5c70
msgid ""
"主要强调在高温环境下保持足部干爽提高舒适度，内衬方面要么是单层考杜拉纤维/特种"
"尼龙布，好点的就换成超级里衬或者coolmax之类的吸汗快干材料．"
msgstr ""

#: ClothingName:3e38f781-4537-4402-a03d-d6988920087c
msgid "丛林靴"
msgstr ""

#: ClothingDescribe:3e38f781-4537-4402-a03d-d6988920087c
msgid ""
"军靴的一种，属单兵装备，常用于丛林和山地作战等，一来有助于提高士气，看着威"
"武．二来可以保住小腿以下，特别是脚踝．"
msgstr ""

#: ClothingName:f8d81422-3b15-4e30-a17b-d4e2e5253181
msgid "飞行靴"
msgstr ""

#: ClothingDescribe:f8d81422-3b15-4e30-a17b-d4e2e5253181
msgid ""
"飞行靴是飞行员装备的特种靴，侧面有加强筋用于保护脆弱的脚踝，保暖性能较好，防"
"滑极佳．"
msgstr ""

#: ClothingName:817e4ae3-354d-4f1e-a69d-fb21aaaeb3dd
msgid "布鞋"
msgstr ""

#: ClothingDescribe:817e4ae3-354d-4f1e-a69d-fb21aaaeb3dd
msgid "顾名思义，即用布制作的鞋．"
msgstr ""

#: ClothingName:c61fce3b-3903-4aaa-aa14-cadb1da9b9ab
msgid "雨靴"
msgstr ""

#: ClothingDescribe:c61fce3b-3903-4aaa-aa14-cadb1da9b9ab
msgid "下雨和泥泞时穿的一种高至踝节部的橡胶或塑料套鞋．"
msgstr ""

#: ClothingName:488b0d65-9111-4d1b-b0a6-9cc774cb6b7b
msgid "连裤袜"
msgstr ""

#: ClothingDescribe:488b0d65-9111-4d1b-b0a6-9cc774cb6b7b
msgid ""
"连裤袜顾名思义，是一种将裤与袜结合在一起的服装，是从臀部到脚部的一体形式的紧"
"身衣物．"
msgstr ""

#: ClothingName:982c52fa-793a-4c3b-8ec6-0ec441ae7174
msgid "船袜"
msgstr ""

#: ClothingDescribe:982c52fa-793a-4c3b-8ec6-0ec441ae7174
msgid "裸露脚踝，袜口隐藏在鞋子里面的袜子．"
msgstr ""

#: ClothingName:1c5984f3-cff5-47da-9035-67fadc98884b
msgid "云袜"
msgstr ""

#: ClothingDescribe:1c5984f3-cff5-47da-9035-67fadc98884b
msgid "传统的汉服袜子，通常为白色，袜口较高．"
msgstr ""

#: ClothingName:75c79175-2421-49cd-a572-c497f76ba798
msgid "短袜"
msgstr ""

#: ClothingDescribe:75c79175-2421-49cd-a572-c497f76ba798
msgid "是一种袜身长度至脚踝上5厘米的袜子，穿着时包裹整个脚踝．"
msgstr ""

#: ClothingName:30195f4d-d60f-406c-8c23-d5ed3e39f539
msgid "中筒袜"
msgstr ""

#: ClothingDescribe:30195f4d-d60f-406c-8c23-d5ed3e39f539
msgid "中筒袜，又叫及膝袜，只到膝盖或膝盖偏下的一种袜子，是袜子的一种．"
msgstr ""

#: ClothingName:cdb7aa57-d001-4182-aa82-d459d5a89e04
msgid "长筒袜"
msgstr ""

#: ClothingDescribe:cdb7aa57-d001-4182-aa82-d459d5a89e04
msgid "长筒袜是长度达到大腿的厚而富有弹性的长袜,属于大腿袜的一种．"
msgstr ""

#: ClothingName:2f8910b6-83d7-44ce-a8fd-c9cb7f732b51
msgid "足袋"
msgstr ""

#: ClothingDescribe:2f8910b6-83d7-44ce-a8fd-c9cb7f732b51
msgid "一种分趾的袜子．"
msgstr ""

#: ClothingName:4e28aae0-d721-411f-a9c2-8bf39a713c7f
msgid "男式胸罩"
msgstr ""

#: ClothingDescribe:4e28aae0-d721-411f-a9c2-8bf39a713c7f
msgid ""
"一种专为男士设计的，没有钢圈和棉垫，罩杯较平，并且只有胸围大小，没有罩杯大小"
"之分的胸罩．"
msgstr ""

#: ClothingName:7c6b8621-9a67-4a18-998e-daa7306d0f57
msgid "无肩带胸罩"
msgstr ""

#: ClothingDescribe:7c6b8621-9a67-4a18-998e-daa7306d0f57
msgid "大多以钢圈来支撑胸部，便于搭配露肩及宽领性感的服饰．"
msgstr ""

#: ClothingName:8c237c3f-ffb2-4e68-b618-55ac7247981b
msgid "无缝胸罩"
msgstr ""

#: ClothingDescribe:8c237c3f-ffb2-4e68-b618-55ac7247981b
msgid ""
"罩杯表面是无缝处理，中间缝入厚的绵垫，胸下围之土台也是无缝处理，适合搭配紧身"
"服饰．"
msgstr ""

#: ClothingName:21c46587-d50e-4e59-9043-4a9877e111e4
msgid "前扣胸罩"
msgstr ""

#: ClothingDescribe:21c46587-d50e-4e59-9043-4a9877e111e4
msgid "指钩扣安装于前方之胸罩，一般便于穿着，也具有集中效果．"
msgstr ""

#: ClothingName:cd713363-d142-4789-b0a2-a1f0cafa7eca
msgid "长束型文胸"
msgstr ""

#: ClothingDescribe:cd713363-d142-4789-b0a2-a1f0cafa7eca
msgid ""
"长束型文胸是标准胸罩一种，罩杯下端之土台较长，能把腹部、背部赘肉及多余的脂肪"
"往胸部集中．"
msgstr ""

#: ClothingName:bfb5c74c-afe5-480b-9d7e-a51b9e20161c
msgid "裹胸布"
msgstr ""

#: ClothingDescribe:bfb5c74c-afe5-480b-9d7e-a51b9e20161c
msgid ""
"缠胸布原本指的是旧式女性为了保持乳房不下坠，或者为了劳动方便，又或者为了避免"
"战争时刀剑伤以至于大出血．而使用布条绑缚自己胸部．"
msgstr ""

#: ClothingName:6a94cbaa-86ef-4778-9049-1351f533d650
msgid "三点式泳衣"
msgstr ""

#: ClothingDescribe:6a94cbaa-86ef-4778-9049-1351f533d650
msgid "性感暴露的女式泳衣．"
msgstr ""

#: ClothingName:218e2dab-89b1-4c09-b5fe-d11b575822c6
msgid "乳贴"
msgstr ""

#: ClothingDescribe:218e2dab-89b1-4c09-b5fe-d11b575822c6
msgid "用在人体胸前乳头上，以覆盖乳晕的一种贴状物体，以达到隐形内衣的效果．"
msgstr ""

#: ClothingName:5f700bf5-e6ce-4978-80e3-e6c0ad1eff61
msgid "肚兜"
msgstr ""

#: ClothingDescribe:5f700bf5-e6ce-4978-80e3-e6c0ad1eff61
msgid "贴身遮护胸腹的布片．菱形，有的有袋，用以贮物．"
msgstr ""

#: ClothingName:65160490-2f39-4dbe-a5a5-476f7a371c0d
msgid "男式三角泳裤"
msgstr ""

#: ClothingDescribe:65160490-2f39-4dbe-a5a5-476f7a371c0d
msgid "性感的三角泳裤，有凸显肌肉线条的作用．"
msgstr ""

#: ClothingName:c3139258-7348-4917-b097-e23f7c414b31
msgid "男式四角泳裤"
msgstr ""

#: ClothingDescribe:c3139258-7348-4917-b097-e23f7c414b31
msgid "以舒适为主要考虑的男式泳裤．"
msgstr ""

#: ClothingName:a148850e-5880-4f3b-b0c7-607c4af0bfa1
msgid "丁字裤"
msgstr ""

#: ClothingDescribe:a148850e-5880-4f3b-b0c7-607c4af0bfa1
msgid ""
"通常此型的内裤是视场合而穿着的，比如穿比较贴身的紧身长裤时搭配，可以避免内裤"
"的线条破坏了臀形的表现，但易导致臀部下垂．"
msgstr ""

#: ClothingName:9ee7f67b-69f1-4e59-9c2d-571c66a50c88
msgid "C字裤"
msgstr ""

#: ClothingDescribe:9ee7f67b-69f1-4e59-9c2d-571c66a50c88
msgid ""
"是一种隐形内裤,C字裤其实是丁字裤的改革体,而且来得异常节省布料,连腰上的部分都"
"省了,直接一片像C字形状的东东贴在下面护住私处．"
msgstr ""

#: ClothingName:49bc3ffb-c8e4-48e8-813e-2637b1ebaf88
msgid "五角裤"
msgstr ""

#: ClothingDescribe:49bc3ffb-c8e4-48e8-813e-2637b1ebaf88
msgid ""
"五角形内裤的设计重点在于底线的弹性有防止臀部下垂、提升臀线的作用, 适合臀部曲"
"线下垂及平板的女性．"
msgstr ""

#: ClothingName:4c30879c-ad72-4216-b69e-bf72673e6bbb
msgid "女式三角泳裤"
msgstr ""

#: ClothingDescribe:4c30879c-ad72-4216-b69e-bf72673e6bbb
msgid "性感的女式三角泳裤，用料特别稀少的被称为比基尼．"
msgstr ""

#: ClothingName:3df9fb77-c032-4a34-8c6e-6f40bbf8435b
msgid "女式四角泳裤"
msgstr ""

#: ClothingDescribe:3df9fb77-c032-4a34-8c6e-6f40bbf8435b
msgid "以舒适为主要考虑的女式泳裤．"
msgstr ""

#: ClothingName:0a553af7-ff84-4d1f-a156-8ff64d805b21
msgid "三角裤"
msgstr ""

#: ClothingDescribe:0a553af7-ff84-4d1f-a156-8ff64d805b21
msgid ""
"三角裤是一种短小、呈Y形的内裤，呈“倒三角形”。三角裤可以很好地衬托出你的身材和"
"盆骨，并且切割了你肩部的肌肉线条．"
msgstr ""

#: ClothingName:153d439c-589a-4c38-88cd-ea0f45a29ac9
msgid "四角裤"
msgstr ""

#: ClothingDescribe:153d439c-589a-4c38-88cd-ea0f45a29ac9
msgid ""
"四角裤，或称平口裤，是一种男装内裤，也有女用类型．其设计源自拳击手所穿的短"
"裤，多以棉料等材质制成，最大的特质为宽松透气．"
msgstr ""

